{
  "nudg": "1.1",
  "note": "An accordion section that opens to exactly its content's height, measured by the host, so a longer answer needs no edit. The panel's height springs without overshoot and the chevron turns; opening, the content fades in once there is room for it, and closing, it fades out at once.",
  "targets": [
    "header",
    "panel",
    "chevron"
  ],
  "values": {
    "panel.height": 0,
    "panel.opacity": 0,
    "chevron.rotation": 0
  },
  "animate": {
    "panel.height": {
      "spring": {
        "duration": 0.35,
        "bounce": 0
      }
    },
    "panel.opacity": {
      "tween": {
        "duration": 0.2,
        "ease": "out"
      }
    },
    "chevron.rotation": {
      "spring": {
        "duration": 0.3,
        "bounce": 0.2
      }
    }
  },
  "initial": "closed",
  "states": {
    "closed": {
      "when": {
        "header.tap": {
          "to": "open",
          "animate": {
            "panel.opacity": {
              "tween": {
                "duration": 0.2,
                "ease": "out"
              },
              "delay": 0.1
            }
          },
          "note": "The content waits for the panel to make room."
        }
      }
    },
    "open": {
      "set": {
        "panel.height": {
          "measure": "panel.naturalHeight"
        },
        "panel.opacity": 1,
        "chevron.rotation": 180
      },
      "when": {
        "header.tap": "closed"
      }
    }
  }
}
