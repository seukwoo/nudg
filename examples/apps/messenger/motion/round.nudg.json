{
  "nudg": "1.2",
  "note": "A round video message. Tapped, it grows and plays: the play badge fades, and a ring around it fills clockwise as the host reports progress (two half-rings, each turning behind a half-circle clip). Tapped again it shrinks and pauses; the host sends ended at the end. The host plays and pauses the video as the file enters playing and paused.",
  "host": {
    "events": [
      "ended"
    ],
    "inputs": {
      "progress": {
        "range": [
          0,
          1
        ],
        "note": "Share of the message played."
      }
    }
  },
  "targets": [
    "round",
    "badge",
    "ring",
    "arcR",
    "arcL"
  ],
  "values": {
    "round.width": 200,
    "round.height": 200,
    "badge.opacity": 1,
    "badge.scale": 1,
    "ring.opacity": 0,
    "arcR.rotation": {
      "map": "host.progress",
      "from": [
        0,
        0.5
      ],
      "to": [
        -135,
        45
      ]
    },
    "arcL.rotation": {
      "map": "host.progress",
      "from": [
        0.5,
        1
      ],
      "to": [
        45,
        225
      ]
    }
  },
  "animate": {
    "round.width": {
      "spring": {
        "duration": 0.4,
        "bounce": 0.15
      }
    },
    "round.height": {
      "spring": {
        "duration": 0.4,
        "bounce": 0.15
      }
    },
    "badge.opacity": {
      "tween": {
        "duration": 0.15,
        "ease": "out"
      }
    },
    "badge.scale": {
      "spring": {
        "duration": 0.3,
        "bounce": 0.2
      }
    },
    "ring.opacity": {
      "tween": {
        "duration": 0.2,
        "ease": "out"
      }
    }
  },
  "initial": "paused",
  "states": {
    "paused": {
      "when": {
        "round.tap": "playing"
      }
    },
    "playing": {
      "set": {
        "round.width": 256,
        "round.height": 256,
        "badge.opacity": 0,
        "badge.scale": 0.6,
        "ring.opacity": 1
      },
      "when": {
        "round.tap": "paused",
        "host.ended": "paused"
      }
    }
  }
}
