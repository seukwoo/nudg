{
  "nudg": "1.1",
  "note": "A card that lifts on hover and settles under a press. Hover and press are independent, so they run as parallel regions on different properties.",
  "targets": ["card"],
  "values": { "card.y": 0, "card.scale": 1 },
  "animate": {
    "card.y": { "spring": { "duration": 0.3, "bounce": 0.2 } },
    "card.scale": { "spring": { "duration": 0.2, "bounce": 0 } }
  },
  "regions": {
    "hover": {
      "initial": "idle",
      "states": {
        "idle": { "when": { "card.hoverstart": "over" } },
        "over": { "set": { "card.y": -6 }, "when": { "card.hoverend": "idle" } }
      }
    },
    "press": {
      "initial": "up",
      "states": {
        "up": { "when": { "card.down": "down" } },
        "down": { "set": { "card.scale": 0.97 }, "when": { "card.up": "up", "card.cancel": "up" } }
      }
    }
  }
}
