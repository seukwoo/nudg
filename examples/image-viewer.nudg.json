{
  "nudg": "1.1",
  "note": "A photo you can zoom. Double-tap toggles 2.5x; two fingers pinch it between 1x and 4x (rubber-banding a little past either), moving it with the fingers' centre; once zoomed, one finger pans it and a fling glides on. Released below 1x, the commit's bounds bring it back. The host closes the viewer and loads the full-resolution image.",
  "targets": ["viewer", "image"],
  "values": {
    "image.scale": { "base": 1, "min": 1, "max": 4 },
    "image.x": 0,
    "image.y": 0
  },
  "animate": {
    "image.scale": { "spring": { "duration": 0.35, "bounce": 0 } },
    "image.x": { "spring": { "duration": 0.35, "bounce": 0 } },
    "image.y": { "spring": { "duration": 0.35, "bounce": 0 } }
  },
  "initial": "fit",
  "when": {
    "image.pinchstart": "pinching"
  },
  "states": {
    "fit": {
      "set": { "image.scale": 1, "image.x": 0, "image.y": 0 },
      "when": { "image.doubletap": "zoomed" }
    },
    "zoomed": {
      "set": { "image.scale": 2.5, "image.x": 0, "image.y": 0 },
      "when": { "image.doubletap": "fit", "image.dragstart": "panning" }
    },
    "pinching": {
      "follow": {
        "image.scale": { "input": "image.pinch.scale", "multiply": true, "overdrag": 0.3 },
        "image.x": "image.pinch.x",
        "image.y": "image.pinch.y"
      },
      "when": { "image.pinchend": { "to": "held", "commit": ["image.scale", "image.x", "image.y"] } }
    },
    "held": {
      "when": { "image.doubletap": "fit", "image.dragstart": "panning" }
    },
    "panning": {
      "follow": { "image.x": "image.drag.x", "image.y": "image.drag.y" },
      "when": { "image.dragend": "drifting" }
    },
    "drifting": {
      "glide": {
        "image.x": { "range": [{ "measure": "viewer.width", "times": -0.75 }, { "measure": "viewer.width", "times": 0.75 }] },
        "image.y": { "range": [{ "measure": "viewer.height", "times": -0.75 }, { "measure": "viewer.height", "times": 0.75 }] }
      },
      "when": { "image.doubletap": "fit", "image.dragstart": "panning" }
    }
  }
}
