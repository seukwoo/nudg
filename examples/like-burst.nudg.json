{
  "nudg": "1.6",
  "note": "The README's like button: the heart pops, buzzes, plays a sound and bursts, all from the file.",
  "targets": [
    "heart",
    "burst"
  ],
  "values": {
    "heart.scale": 1,
    "heart.color": "#9CA3AF"
  },
  "animate": {
    "heart.scale": {
      "spring": {
        "duration": 0.3,
        "bounce": 0.5
      }
    },
    "heart.color": {
      "tween": {
        "duration": 0.15,
        "ease": "out"
      }
    }
  },
  "emitters": {
    "burst": {
      "from": "heart",
      "count": 16,
      "speed": [
        120,
        260
      ],
      "life": [
        0.4,
        0.7
      ],
      "gravity": 300,
      "seed": 5
    }
  },
  "initial": "off",
  "states": {
    "off": {
      "when": {
        "heart.tap": "on"
      }
    },
    "on": {
      "set": {
        "heart.color": "#F43F5E"
      },
      "enter": {
        "heart.scale": {
          "kick": 6,
          "spring": {
            "duration": 0.4,
            "bounce": 0.5
          }
        }
      },
      "cue": {
        "sound": "heart",
        "haptic": "success"
      },
      "emit": "burst",
      "when": {
        "heart.tap": "off"
      }
    }
  }
}
