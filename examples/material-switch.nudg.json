{
  "nudg": "1.1",
  "note": "A Material 3 switch with the Expressive motion scheme: the handle grows from 16 to 24 dp and slides with the spatial spring; the colors change with the effects spring, which never bounces. Only the import differs from ios-toggle.nudg.json.",
  "import": ["./motion/material-expressive.nudg.json"],
  "targets": ["knob", "track"],
  "values": { "knob.x": 0, "knob.scale": 0.667, "knob.color": "#79747E", "track.color": "#E6E0E9" },
  "animate": {
    "knob.x": "standard",
    "knob.scale": "standard",
    "knob.color": "fade",
    "track.color": "fade"
  },
  "initial": "off",
  "when": { "host.check": "on", "host.uncheck": "off" },
  "states": {
    "off": { "when": { "track.tap": "on" } },
    "on": {
      "set": { "knob.x": 20, "knob.scale": 1, "knob.color": "#FFFFFF", "track.color": "#6750A4" },
      "when": { "track.tap": "off" }
    }
  }
}
