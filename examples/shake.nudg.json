{
  "nudg": "1.0",
  "note": "A field that turns red and plays an authored multi-beat shake when the app rejects it. Rejecting again restarts from the current position; reduced motion skips the shake.",
  "targets": ["field"],
  "values": { "field.x": 0, "field.color": "#D1D5DB" },
  "animate": {
    "field.x": { "spring": { "duration": 0.3, "bounce": 0 } },
    "field.color": { "tween": { "duration": 0.2, "ease": "out" } }
  },
  "initial": "idle",
  "when": { "host.invalid": "invalid", "host.valid": "idle" },
  "states": {
    "idle": {},
    "invalid": {
      "set": { "field.color": "#F87171" },
      "enter": {
        "field.x": {
          "keyframes": [
            { "at": 0.16, "value": -10 },
            { "at": 0.36, "value": 9 },
            { "at": 0.58, "value": -6 },
            { "at": 0.78, "value": 4 }
          ],
          "duration": 0.42,
          "ease": "out-quad"
        }
      }
    }
  }
}
