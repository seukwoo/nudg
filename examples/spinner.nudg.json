{
  "nudg": "1.1",
  "note": "An indeterminate spinner. It fades and grows in when the app starts work, turns at a constant rate while the work runs, and stops by the shortest turn as it fades out. Reduced motion holds it still; the label says it's busy.",
  "targets": ["spinner"],
  "values": { "spinner.rotation": 0, "spinner.opacity": 0, "spinner.scale": 0.6 },
  "animate": {
    "spinner.rotation": { "spring": { "duration": 0.3, "bounce": 0 } },
    "spinner.opacity": { "tween": { "duration": 0.15, "ease": "out" } },
    "spinner.scale": { "spring": { "duration": 0.3, "bounce": 0 } }
  },
  "initial": "idle",
  "states": {
    "idle": { "when": { "host.start": "spinning" } },
    "spinning": {
      "set": { "spinner.opacity": 1, "spinner.scale": 1 },
      "loop": { "spinner.rotation": { "to": 360, "duration": 0.9, "wrap": 360 } },
      "when": { "host.done": "idle" }
    }
  }
}
