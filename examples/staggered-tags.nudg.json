{
  "nudg": "1.7",
  "note": "Three cards rise one after another, and each card's tag pops in just after its card lands, with a rising pop. The tags' kicks wait (format 1.7), so there's no timer per item. The whole stagger takes 0.74 s on purpose, so slow-transition is kept.",
  "keep": [
    "slow-transition"
  ],
  "host": {
    "events": [
      "show",
      "hide"
    ]
  },
  "targets": [
    "card1",
    "card2",
    "card3",
    "tag1",
    "tag2",
    "tag3"
  ],
  "values": {
    "card1.y": 16,
    "card1.opacity": 0,
    "tag1.scale": 0,
    "tag1.opacity": 0,
    "card2.y": 16,
    "card2.opacity": 0,
    "tag2.scale": 0,
    "tag2.opacity": 0,
    "card3.y": 16,
    "card3.opacity": 0,
    "tag3.scale": 0,
    "tag3.opacity": 0
  },
  "animate": {
    "card1.y": {
      "spring": {
        "duration": 0.45,
        "bounce": 0.15
      }
    },
    "card1.opacity": {
      "tween": {
        "duration": 0.2,
        "ease": "out"
      }
    },
    "tag1.scale": {
      "spring": {
        "duration": 0.35,
        "bounce": 0.3
      }
    },
    "tag1.opacity": {
      "tween": {
        "duration": 0.1,
        "ease": "out"
      }
    },
    "card2.y": {
      "spring": {
        "duration": 0.45,
        "bounce": 0.15
      }
    },
    "card2.opacity": {
      "tween": {
        "duration": 0.2,
        "ease": "out"
      }
    },
    "tag2.scale": {
      "spring": {
        "duration": 0.35,
        "bounce": 0.3
      }
    },
    "tag2.opacity": {
      "tween": {
        "duration": 0.1,
        "ease": "out"
      }
    },
    "card3.y": {
      "spring": {
        "duration": 0.45,
        "bounce": 0.15
      }
    },
    "card3.opacity": {
      "tween": {
        "duration": 0.2,
        "ease": "out"
      }
    },
    "tag3.scale": {
      "spring": {
        "duration": 0.35,
        "bounce": 0.3
      }
    },
    "tag3.opacity": {
      "tween": {
        "duration": 0.1,
        "ease": "out"
      }
    }
  },
  "initial": "hidden",
  "states": {
    "hidden": {
      "when": {
        "host.show": {
          "to": "shown",
          "animate": {
            "tag1.scale": {
              "spring": {
                "duration": 0.35,
                "bounce": 0.3
              },
              "delay": 0.22
            },
            "tag1.opacity": {
              "tween": {
                "duration": 0.1,
                "ease": "out"
              },
              "delay": 0.22
            },
            "card2.y": {
              "spring": {
                "duration": 0.45,
                "bounce": 0.15
              },
              "delay": 0.08
            },
            "card2.opacity": {
              "tween": {
                "duration": 0.2,
                "ease": "out"
              },
              "delay": 0.08
            },
            "tag2.scale": {
              "spring": {
                "duration": 0.35,
                "bounce": 0.3
              },
              "delay": 0.3
            },
            "tag2.opacity": {
              "tween": {
                "duration": 0.1,
                "ease": "out"
              },
              "delay": 0.3
            },
            "card3.y": {
              "spring": {
                "duration": 0.45,
                "bounce": 0.15
              },
              "delay": 0.16
            },
            "card3.opacity": {
              "tween": {
                "duration": 0.2,
                "ease": "out"
              },
              "delay": 0.16
            },
            "tag3.scale": {
              "spring": {
                "duration": 0.35,
                "bounce": 0.3
              },
              "delay": 0.38
            },
            "tag3.opacity": {
              "tween": {
                "duration": 0.1,
                "ease": "out"
              },
              "delay": 0.38
            }
          },
          "cue": [
            {
              "sound": "pop",
              "delay": 0.22,
              "pitch": 0,
              "haptic": "light"
            },
            {
              "sound": "pop",
              "delay": 0.3,
              "pitch": 2
            },
            {
              "sound": "pop",
              "delay": 0.38,
              "pitch": 4
            }
          ]
        }
      }
    },
    "shown": {
      "set": {
        "card1.y": 0,
        "card1.opacity": 1,
        "tag1.scale": 1,
        "tag1.opacity": 1,
        "card2.y": 0,
        "card2.opacity": 1,
        "tag2.scale": 1,
        "tag2.opacity": 1,
        "card3.y": 0,
        "card3.opacity": 1,
        "tag3.scale": 1,
        "tag3.opacity": 1
      },
      "enter": {
        "tag1.scale": {
          "kick": 8,
          "spring": {
            "duration": 0.35,
            "bounce": 0.3
          },
          "delay": 0.22
        },
        "tag2.scale": {
          "kick": 8,
          "spring": {
            "duration": 0.35,
            "bounce": 0.3
          },
          "delay": 0.3
        },
        "tag3.scale": {
          "kick": 8,
          "spring": {
            "duration": 0.35,
            "bounce": 0.3
          },
          "delay": 0.38
        }
      },
      "when": {
        "host.hide": "hidden"
      }
    }
  }
}
