{
  "nudg": "0.9",
  "note": "A list row that swipes left to reveal a delete action. A short or slow swipe snaps back; a long or quick one stays open. The action fades in with the swipe.",
  "targets": ["row", "content", "action"],
  "values": {
    "content.x": 0,
    "row.opacity": 1,
    "action.opacity": {
      "map": "content.x",
      "from": [
        0,
        { "measure": "action.width", "times": -0.5 },
        { "measure": "action.width", "times": -1 }
      ],
      "to": [0, 0.2, 1]
    }
  },
  "animate": {
    "content.x": { "spring": { "duration": 0.4, "bounce": 0 } },
    "row.opacity": { "tween": { "duration": 0.25, "ease": "out" } }
  },
  "initial": "closed",
  "states": {
    "closed": {
      "when": { "content.dragstart": "dragging" }
    },
    "open": {
      "set": { "content.x": { "measure": "action.width", "times": -1 } },
      "when": { "content.dragstart": "dragging", "content.tap": "closed", "action.tap": "deleted" }
    },
    "dragging": {
      "follow": {
        "content.x": {
          "input": "content.drag.x",
          "range": [{ "measure": "action.width", "times": -1 }, 0],
          "overdrag": 0.25
        }
      },
      "when": { "content.dragend": { "nearest": ["closed", "open"], "by": "content.x" } }
    },
    "deleted": {
      "set": { "content.x": -360, "row.opacity": 0 }
    }
  }
}
