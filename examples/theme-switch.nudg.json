{
  "nudg": "1.8",
  "note": "A settings card whose colors come from the app's theme. Flip the switch and the page changes its theme class; every color nudg draws moves to the new theme's value with its own motion, and the rows keep their hover tint in either theme.",
  "host": {
    "colors": {
      "surface": {
        "default": "#FFFFFF"
      },
      "hover": {
        "default": "#F3F4F6"
      },
      "track": {
        "default": "#D1D5DB"
      },
      "accent": {
        "default": "#6366F1"
      }
    }
  },
  "targets": [
    "panel",
    "row1",
    "row2",
    "track",
    "knob"
  ],
  "values": {
    "panel.color": {
      "color": "surface"
    },
    "row1.color": {
      "color": "surface"
    },
    "row2.color": {
      "color": "surface"
    },
    "track.color": {
      "color": "track"
    },
    "knob.x": 0
  },
  "animate": {
    "panel.color": {
      "tween": {
        "duration": 0.25,
        "ease": "out"
      }
    },
    "row1.color": {
      "tween": {
        "duration": 0.25,
        "ease": "out"
      }
    },
    "row2.color": {
      "tween": {
        "duration": 0.25,
        "ease": "out"
      }
    },
    "track.color": {
      "tween": {
        "duration": 0.25,
        "ease": "out"
      }
    },
    "knob.x": {
      "spring": {
        "duration": 0.35,
        "bounce": 0.25
      }
    }
  },
  "regions": {
    "dark": {
      "initial": "off",
      "states": {
        "off": {
          "when": {
            "track.tap": {
              "to": "on",
              "cue": {
                "sound": "tick",
                "haptic": "select"
              }
            }
          }
        },
        "on": {
          "set": {
            "knob.x": 20,
            "track.color": {
              "color": "accent"
            }
          },
          "when": {
            "track.tap": {
              "to": "off",
              "cue": {
                "sound": "tick",
                "haptic": "select"
              }
            }
          }
        }
      }
    },
    "hover1": {
      "initial": "out",
      "states": {
        "out": {
          "when": {
            "row1.hoverstart": "over"
          }
        },
        "over": {
          "set": {
            "row1.color": {
              "color": "hover"
            }
          },
          "when": {
            "row1.hoverend": "out"
          }
        }
      }
    },
    "hover2": {
      "initial": "out",
      "states": {
        "out": {
          "when": {
            "row2.hoverstart": "over"
          }
        },
        "over": {
          "set": {
            "row2.color": {
              "color": "hover"
            }
          },
          "when": {
            "row2.hoverend": "out"
          }
        }
      }
    }
  }
}
