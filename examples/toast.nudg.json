{
  "nudg": "0.3",
  "note": "A toast the app shows. It rises with a soft spring while fading in with a tween, hides itself after 3 s (a timer, restarted by another host.show), and tapping it dismisses it early.",
  "targets": ["toast"],
  "values": { "toast.y": 24, "toast.opacity": 0 },
  "animate": {
    "toast.y": { "spring": { "duration": 0.4, "bounce": 0.25 } },
    "toast.opacity": { "tween": { "duration": 0.2, "ease": "out" } }
  },
  "initial": "hidden",
  "when": { "host.show": "shown", "host.hide": "hidden" },
  "states": {
    "hidden": {},
    "shown": {
      "set": { "toast.y": 0, "toast.opacity": 1 },
      "when": { "after:3s": "hidden", "toast.tap": "hidden" }
    }
  }
}
