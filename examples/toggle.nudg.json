{
  "nudg": "0.1",
  "note": "A switch whose knob springs across the track on tap.",
  "targets": ["knob", "track"],
  "values": {
    "knob.x": 0,
    "track.color": "#D1D5DB"
  },
  "animate": {
    "knob.x": { "spring": { "duration": 0.35, "bounce": 0.25 } },
    "track.color": { "tween": { "duration": 0.2, "ease": "out" } }
  },
  "initial": "off",
  "states": {
    "off": {
      "when": { "track.tap": "on" }
    },
    "on": {
      "set": { "knob.x": 20, "track.color": "#4ADE80" },
      "when": { "track.tap": "off" }
    }
  }
}
