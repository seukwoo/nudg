{
  "name": "@nudg/core",
  "version": "0.4.0",
  "description": "The interaction format your AI can nudge.",
  "keywords": [
    "animation",
    "motion",
    "interaction",
    "micro-interactions",
    "spring",
    "state-machine",
    "ui",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "author": "seukwoo",
  "homepage": "https://github.com/seukwoo/nudg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seukwoo/nudg.git"
  },
  "bugs": {
    "url": "https://github.com/seukwoo/nudg/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./schema.json": "./spec/nudg-0.3.schema.json",
    "./guide.md": "./spec/guide.md",
    "./motion/*": "./examples/motion/*",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "nudg": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.4"
  },
  "files": [
    "dist",
    "spec/guide.md",
    "examples/motion/apple.nudg.json",
    "examples/motion/material-expressive.nudg.json",
    "examples/motion/material-standard.nudg.json",
    "spec/nudg-0.1.schema.json",
    "spec/nudg-0.2.schema.json",
    "spec/nudg-0.3.schema.json"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc && tsc -p tsconfig.core.json",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "demo": "npm run build && node demo/serve.mjs",
    "media": "node scripts/readme-media.ts",
    "nudg": "node src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "ajv": "^8.20.0",
    "react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
