{
  "name": "@nudg/core",
  "version": "0.8.0",
  "description": "Standard interaction recipes and portable motion your AI can nudge.",
  "keywords": [
    "animation",
    "motion",
    "interaction",
    "micro-interactions",
    "spring",
    "state-machine",
    "ui",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "author": "seukwoo",
  "homepage": "https://github.com/seukwoo/nudg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seukwoo/nudg.git"
  },
  "bugs": {
    "url": "https://github.com/seukwoo/nudg/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./schema.json": "./spec/nudg-0.6.schema.json",
    "./recipes.json": "./recipes/index.json",
    "./recipes.schema.json": "./recipes/schema.json",
    "./guide.md": "./spec/guide.md",
    "./motion/*": "./examples/motion/*",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "nudg": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.4"
  },
  "files": [
    "dist",
    "spec/guide.md",
    "recipes/index.json",
    "recipes/schema.json",
    "examples/*.nudg.json",
    "examples/motion/*.nudg.json",
    "spec/nudg-0.1.schema.json",
    "spec/nudg-0.2.schema.json",
    "spec/nudg-0.3.schema.json",
    "spec/nudg-0.4.schema.json",
    "spec/nudg-0.5.schema.json",
    "spec/nudg-0.6.schema.json"
  ],
  "scripts": {
    "test": "NUDG_LOG=off NUDG_OPEN=false node --test --test-force-exit --test-concurrency=3 \"test/*.test.ts\"",
    "typecheck": "tsc && tsc -p tsconfig.core.json",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "demo": "npm run build && node demo/serve.mjs",
    "media": "node scripts/readme-media.ts",
    "nudg": "node src/cli.ts"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.25.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  }
}
