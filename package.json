{
  "name": "@nudg/core",
  "version": "0.1.0",
  "description": "The interaction format your AI can nudge.",
  "keywords": [
    "animation",
    "motion",
    "interaction",
    "micro-interactions",
    "spring",
    "state-machine",
    "ui",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "author": "seukwoo",
  "homepage": "https://github.com/seukwoo/nudg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seukwoo/nudg.git"
  },
  "bugs": {
    "url": "https://github.com/seukwoo/nudg/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./schema.json": "./spec/nudg-0.1.schema.json",
    "./guide.md": "./spec/guide.md",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "nudg": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.4"
  },
  "files": [
    "dist",
    "spec/nudg-0.1.schema.json",
    "spec/guide.md"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc && tsc -p tsconfig.core.json",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "demo": "npm run build && python3 -m http.server 8787",
    "nudg": "node src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
