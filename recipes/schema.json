{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nudg.dev/recipes/schema.json",
  "title": "nudg recipe catalog",
  "type": "object",
  "required": ["version", "recipes"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 2 },
    "recipes": {
      "type": "array",
      "items": { "$ref": "#/$defs/recipe" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "recipe": {
      "type": "object",
      "required": ["id", "aliases", "summary", "starter", "examples", "parts", "states", "events", "inputs", "hostResponsibilities", "motion", "gaps"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "aliases": { "$ref": "#/$defs/stringList" },
        "summary": { "type": "string", "minLength": 1 },
        "starter": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "The validated example to start from, or null when the format can't express the pattern's essential motion yet; its gaps then say what is missing and the host does that part."
        },
        "examples": { "$ref": "#/$defs/stringList" },
        "parts": {
          "type": "object",
          "required": ["required", "optional"],
          "properties": {
            "required": { "$ref": "#/$defs/stringList" },
            "optional": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        },
        "states": { "$ref": "#/$defs/stringList" },
        "events": { "$ref": "#/$defs/stringList" },
        "inputs": { "$ref": "#/$defs/stringList" },
        "hostResponsibilities": { "$ref": "#/$defs/stringList" },
        "motion": { "$ref": "#/$defs/stringList" },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["capability", "status", "need"],
            "properties": {
              "capability": {
                "enum": ["sequence", "stagger", "collection coordination", "continuous motion", "scroll direction", "screen composition", "multi-pointer", "decay"],
                "description": "The lower-level capability the pattern needs. A fixed list, so gaps can be counted across the catalog."
              },
              "status": { "enum": ["missing", "workaround"] },
              "need": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "if": { "properties": { "starter": { "const": null } } },
      "then": {
        "properties": {
          "examples": { "maxItems": 0 },
          "gaps": { "contains": { "properties": { "status": { "const": "missing" } } } }
        }
      }
    }
  }
}
