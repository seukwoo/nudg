{
  "conformance": "1.3",
  "name": "Cues under reduced motion: skipped entry beats leave their first cue at the moment of entry; a fade loop still beats",
  "doc": {
    "nudg": "1.3",
    "host": {
      "events": [
        "invalid",
        "valid"
      ],
      "inputs": {
        "level": {
          "range": [
            0,
            1
          ]
        }
      }
    },
    "targets": [
      "field",
      "dot"
    ],
    "values": {
      "field.x": 0,
      "dot.opacity": 1
    },
    "animate": {
      "field.x": {
        "spring": {
          "duration": 0.3,
          "bounce": 0
        }
      }
    },
    "initial": "idle",
    "states": {
      "idle": {
        "when": {
          "host.invalid": "invalid"
        }
      },
      "invalid": {
        "enter": {
          "field.x": {
            "keyframes": [
              {
                "at": 0.25,
                "value": -10,
                "cue": "tick"
              },
              {
                "at": 0.75,
                "value": 5,
                "cue": {
                  "haptic": "tick",
                  "intensity": 0.5
                }
              }
            ],
            "duration": 0.4
          }
        },
        "loop": {
          "dot.opacity": {
            "keyframes": [
              {
                "at": 0.5,
                "value": -0.5,
                "cue": {
                  "sound": "blip",
                  "pitch": {
                    "input": "host.level",
                    "times": 12
                  }
                }
              }
            ],
            "to": 0,
            "duration": 0.2,
            "delay": 0.1
          }
        },
        "when": {
          "host.valid": "idle"
        }
      }
    }
  },
  "reducedMotion": true,
  "steps": [
    {
      "t": 0,
      "input": "host.level",
      "value": 0.5
    },
    {
      "t": 0.1,
      "send": "host.invalid"
    },
    {
      "t": 0.6,
      "send": "host.valid"
    },
    {
      "t": 0.65,
      "expect": {
        "cues": [
          {
            "t": 0.1,
            "sound": "tick",
            "haptic": "tick",
            "intensity": 1.0,
            "pitch": 0.0
          },
          {
            "t": 0.3,
            "sound": "blip",
            "intensity": 1.0,
            "pitch": 6
          },
          {
            "t": 0.5,
            "sound": "blip",
            "intensity": 1.0,
            "pitch": 6
          }
        ]
      }
    }
  ]
}
