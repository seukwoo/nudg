{
  "conformance": "1.2",
  "name": "Delay from an input: input \u00d7 times + plus seconds, read when the transition fires",
  "doc": {
    "nudg": "1.2",
    "host": {
      "events": [
        "show"
      ],
      "inputs": {
        "index": {
          "range": [
            0,
            100
          ]
        }
      }
    },
    "targets": [
      "card"
    ],
    "values": {
      "card.y": 20
    },
    "animate": {
      "card.y": {
        "spring": {
          "duration": 0.3,
          "bounce": 0
        },
        "delay": {
          "input": "host.index",
          "times": 0.06,
          "plus": 0.02,
          "max": 0.2
        }
      }
    },
    "initial": "hidden",
    "states": {
      "hidden": {
        "when": {
          "host.show": "shown"
        }
      },
      "shown": {
        "set": {
          "card.y": 0
        }
      }
    }
  },
  "steps": [
    {
      "t": 0,
      "input": "host.index",
      "value": 2
    },
    {
      "t": 0.1,
      "send": "host.show"
    },
    {
      "t": 0.15,
      "input": "host.index",
      "value": 0
    },
    {
      "t": 0.2,
      "expect": {
        "state": [
          "shown"
        ],
        "values": {
          "card.y": 20
        },
        "resting": false
      }
    },
    {
      "t": 0.3,
      "expect": {
        "values": {
          "card.y": 12.845208871
        }
      }
    },
    {
      "t": 0.5,
      "expect": {
        "values": {
          "card.y": 0.556368706
        }
      }
    }
  ]
}
