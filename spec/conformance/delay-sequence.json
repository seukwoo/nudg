{
  "conformance": "0.12",
  "name": "Delay: a motion starts after its delay, the property holding what it was doing; a transition's animate can delay it; a retarget during a delay drops the pending motion",
  "doc": {
    "nudg": "0.12",
    "targets": [
      "header",
      "chevron",
      "panel"
    ],
    "values": {
      "chevron.rotation": 0,
      "panel.height": 0
    },
    "animate": {
      "chevron.rotation": {
        "tween": {
          "duration": 0.2,
          "ease": "linear"
        }
      },
      "panel.height": {
        "spring": {
          "duration": 0.3,
          "bounce": 0
        },
        "delay": 0.1
      }
    },
    "initial": "closed",
    "states": {
      "closed": {
        "when": {
          "header.tap": "open"
        }
      },
      "open": {
        "set": {
          "chevron.rotation": 180,
          "panel.height": 100
        },
        "when": {
          "header.tap": {
            "to": "closed",
            "animate": {
              "chevron.rotation": {
                "tween": {
                  "duration": 0.2,
                  "ease": "linear"
                },
                "delay": 0.15
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "t": 0.1,
      "send": "header.tap"
    },
    {
      "t": 0.15,
      "expect": {
        "state": [
          "open"
        ],
        "values": {
          "chevron.rotation": 45,
          "panel.height": 0
        }
      }
    },
    {
      "t": 0.2,
      "expect": {
        "values": {
          "chevron.rotation": 90,
          "panel.height": 0
        }
      }
    },
    {
      "t": 0.3,
      "expect": {
        "values": {
          "chevron.rotation": 180,
          "panel.height": 61.894160918
        }
      }
    },
    {
      "t": 0.5,
      "send": "header.tap"
    },
    {
      "t": 0.52,
      "expect": {
        "state": [
          "closed"
        ],
        "values": {
          "chevron.rotation": 180,
          "panel.height": 99.053898815
        }
      }
    },
    {
      "t": 0.55,
      "send": "header.tap"
    },
    {
      "t": 0.6,
      "expect": {
        "state": [
          "open"
        ],
        "values": {
          "chevron.rotation": 180,
          "panel.height": 99.78434782
        }
      }
    },
    {
      "t": 0.7,
      "expect": {
        "state": [
          "open"
        ],
        "values": {
          "chevron.rotation": 180,
          "panel.height": 99.967512445
        }
      }
    },
    {
      "t": 1.2,
      "expect": {
        "state": [
          "open"
        ],
        "values": {
          "chevron.rotation": 180,
          "panel.height": 99.99999824
        }
      }
    }
  ]
}
