{
  "conformance": "0.2",
  "name": "Drag: a flick released short of the midpoint projects past it and springs on with the finger's velocity",
  "doc": {
    "nudg": "0.2",
    "targets": [
      "knob",
      "track"
    ],
    "values": {
      "knob.x": 0,
      "track.color": {
        "map": "knob.x",
        "from": [
          0,
          20
        ],
        "to": [
          "#D1D5DB",
          "#4ADE80"
        ]
      }
    },
    "animate": {
      "knob.x": {
        "spring": {
          "duration": 0.35,
          "bounce": 0.25
        }
      }
    },
    "initial": "off",
    "states": {
      "off": {
        "when": {
          "track.tap": "on",
          "track.dragstart": "dragging"
        }
      },
      "on": {
        "set": {
          "knob.x": 20
        },
        "when": {
          "track.tap": "off",
          "track.dragstart": "dragging"
        }
      },
      "dragging": {
        "follow": {
          "knob.x": {
            "input": "track.drag.x",
            "range": [
              0,
              20
            ],
            "overdrag": 0.3
          }
        },
        "when": {
          "track.dragend": {
            "nearest": [
              "off",
              "on"
            ],
            "by": "knob.x"
          }
        }
      }
    }
  },
  "steps": [
    {
      "t": 0,
      "expect": {
        "state": [
          "off"
        ],
        "values": {
          "knob.x": 0,
          "track.color": "#d1d5db"
        }
      }
    },
    {
      "t": 0.1,
      "send": "track.dragstart"
    },
    {
      "t": 0.12,
      "input": "track.drag.x",
      "value": 0.1
    },
    {
      "t": 0.13,
      "expect": {
        "state": [
          "dragging"
        ],
        "values": {
          "knob.x": 0.1,
          "track.color": "#d0d5db"
        }
      }
    },
    {
      "t": 0.14,
      "input": "track.drag.x",
      "value": 0.2
    },
    {
      "t": 0.16,
      "input": "track.drag.x",
      "value": 0.3
    },
    {
      "t": 0.17,
      "expect": {
        "state": [
          "dragging"
        ],
        "values": {
          "knob.x": 0.3,
          "track.color": "#cfd5da"
        }
      }
    },
    {
      "t": 0.18,
      "input": "track.drag.x",
      "value": 0.4
    },
    {
      "t": 0.2,
      "input": "track.drag.x",
      "value": 0.5
    },
    {
      "t": 0.21,
      "expect": {
        "state": [
          "dragging"
        ],
        "values": {
          "knob.x": 0.5,
          "track.color": "#ced5d9"
        }
      }
    },
    {
      "t": 0.22,
      "input": "track.drag.x",
      "value": 0.6
    },
    {
      "t": 0.24,
      "input": "track.drag.x",
      "value": 0.7
    },
    {
      "t": 0.25,
      "expect": {
        "state": [
          "dragging"
        ],
        "values": {
          "knob.x": 0.7,
          "track.color": "#cdd6d8"
        }
      }
    },
    {
      "t": 0.26,
      "input": "track.drag.x",
      "value": 0.8
    },
    {
      "t": 0.28,
      "input": "track.drag.x",
      "value": 0.9
    },
    {
      "t": 0.29,
      "expect": {
        "state": [
          "dragging"
        ],
        "values": {
          "knob.x": 0.9,
          "track.color": "#ccd6d7"
        }
      }
    },
    {
      "t": 0.3,
      "input": "track.drag.x",
      "value": 1.0
    },
    {
      "t": 0.32,
      "input": "track.drag.x",
      "value": 1.1
    },
    {
      "t": 0.33,
      "expect": {
        "state": [
          "dragging"
        ],
        "values": {
          "knob.x": 1.1,
          "track.color": "#cbd6d6"
        }
      }
    },
    {
      "t": 0.34,
      "input": "track.drag.x",
      "value": 1.2
    },
    {
      "t": 0.36,
      "input": "track.drag.x",
      "value": 3.2
    },
    {
      "t": 0.37,
      "expect": {
        "state": [
          "dragging"
        ],
        "values": {
          "knob.x": 3.2,
          "track.color": "#c1d7cd"
        }
      }
    },
    {
      "t": 0.38,
      "input": "track.drag.x",
      "value": 5.6
    },
    {
      "t": 0.4,
      "input": "track.drag.x",
      "value": 8.0
    },
    {
      "t": 0.41,
      "send": "track.dragend"
    },
    {
      "t": 0.41,
      "expect": {
        "state": [
          "on"
        ],
        "values": {
          "knob.x": 8.0,
          "track.color": "#a6dab8"
        }
      }
    },
    {
      "t": 0.45,
      "expect": {
        "state": [
          "on"
        ],
        "values": {
          "knob.x": 12.186052775,
          "track.color": "#8cdca5"
        }
      }
    },
    {
      "t": 0.51,
      "expect": {
        "state": [
          "on"
        ],
        "values": {
          "knob.x": 17.398162431,
          "track.color": "#65dd8d"
        }
      }
    },
    {
      "t": 0.61,
      "expect": {
        "state": [
          "on"
        ],
        "values": {
          "knob.x": 20.305865919,
          "track.color": "#4ade80"
        }
      }
    },
    {
      "t": 0.81,
      "expect": {
        "state": [
          "on"
        ],
        "values": {
          "knob.x": 20.02516485,
          "track.color": "#4ade80"
        }
      }
    }
  ]
}
