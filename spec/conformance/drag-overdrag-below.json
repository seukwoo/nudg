{
  "conformance": "0.2",
  "name": "Drag: below the range, released while moving; the spring starts with the input's velocity times overdrag",
  "doc": {
    "nudg": "0.2",
    "targets": [
      "knob",
      "track"
    ],
    "values": {
      "knob.x": 0,
      "track.color": {
        "map": "knob.x",
        "from": [
          0,
          20
        ],
        "to": [
          "#D1D5DB",
          "#4ADE80"
        ]
      }
    },
    "animate": {
      "knob.x": {
        "spring": {
          "duration": 0.35,
          "bounce": 0.25
        }
      }
    },
    "initial": "off",
    "states": {
      "off": {
        "when": {
          "track.tap": "on",
          "track.dragstart": "dragging"
        }
      },
      "on": {
        "set": {
          "knob.x": 20
        },
        "when": {
          "track.tap": "off",
          "track.dragstart": "dragging"
        }
      },
      "dragging": {
        "follow": {
          "knob.x": {
            "input": "track.drag.x",
            "range": [
              0,
              20
            ],
            "overdrag": 0.3
          }
        },
        "when": {
          "track.dragend": {
            "nearest": [
              "off",
              "on"
            ],
            "by": "knob.x"
          }
        }
      }
    }
  },
  "steps": [
    {
      "t": 0,
      "expect": {
        "state": [
          "off"
        ],
        "values": {
          "knob.x": 0,
          "track.color": "#d1d5db"
        }
      }
    },
    {
      "t": 0.1,
      "send": "track.dragstart"
    },
    {
      "t": 0.12,
      "input": "track.drag.x",
      "value": -1.0
    },
    {
      "t": 0.13,
      "expect": {
        "state": [
          "dragging"
        ],
        "values": {
          "knob.x": -0.3,
          "track.color": "#d1d5db"
        }
      }
    },
    {
      "t": 0.14,
      "input": "track.drag.x",
      "value": -2.0
    },
    {
      "t": 0.16,
      "input": "track.drag.x",
      "value": -3.0
    },
    {
      "t": 0.17,
      "expect": {
        "state": [
          "dragging"
        ],
        "values": {
          "knob.x": -0.9,
          "track.color": "#d1d5db"
        }
      }
    },
    {
      "t": 0.18,
      "input": "track.drag.x",
      "value": -4.0
    },
    {
      "t": 0.2,
      "input": "track.drag.x",
      "value": -5.0
    },
    {
      "t": 0.21,
      "expect": {
        "state": [
          "dragging"
        ],
        "values": {
          "knob.x": -1.5,
          "track.color": "#d1d5db"
        }
      }
    },
    {
      "t": 0.22,
      "input": "track.drag.x",
      "value": -6.0
    },
    {
      "t": 0.24,
      "input": "track.drag.x",
      "value": -7.0
    },
    {
      "t": 0.25,
      "expect": {
        "state": [
          "dragging"
        ],
        "values": {
          "knob.x": -2.1,
          "track.color": "#d1d5db"
        }
      }
    },
    {
      "t": 0.26,
      "input": "track.drag.x",
      "value": -8.0
    },
    {
      "t": 0.28,
      "input": "track.drag.x",
      "value": -9.0
    },
    {
      "t": 0.29,
      "expect": {
        "state": [
          "dragging"
        ],
        "values": {
          "knob.x": -2.7,
          "track.color": "#d1d5db"
        }
      }
    },
    {
      "t": 0.3,
      "input": "track.drag.x",
      "value": -10.0
    },
    {
      "t": 0.31,
      "send": "track.dragend"
    },
    {
      "t": 0.31,
      "expect": {
        "state": [
          "off"
        ],
        "values": {
          "knob.x": -3.0,
          "track.color": "#d1d5db"
        }
      }
    },
    {
      "t": 0.35,
      "expect": {
        "state": [
          "off"
        ],
        "values": {
          "knob.x": -2.80194503,
          "track.color": "#d1d5db"
        }
      }
    },
    {
      "t": 0.41,
      "expect": {
        "state": [
          "off"
        ],
        "values": {
          "knob.x": -1.417559543,
          "track.color": "#d1d5db"
        }
      }
    },
    {
      "t": 0.51,
      "expect": {
        "state": [
          "off"
        ],
        "values": {
          "knob.x": -0.072845194,
          "track.color": "#d1d5db"
        }
      }
    },
    {
      "t": 0.71,
      "expect": {
        "state": [
          "off"
        ],
        "values": {
          "knob.x": 0.020848612,
          "track.color": "#d1d5db"
        }
      }
    }
  ]
}
