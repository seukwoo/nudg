{
  "conformance": "0.4",
  "name": "Layout: measured positions align, measured sizes size, the first report places, a relayout retargets with velocity",
  "doc": {
    "nudg": "0.4",
    "targets": [
      "seg1",
      "seg2",
      "seg3",
      "indicator"
    ],
    "values": {
      "indicator.x": 0,
      "indicator.width": {
        "measure": "seg1.width"
      }
    },
    "animate": {
      "indicator.x": {
        "spring": {
          "duration": 0.3,
          "bounce": 0.1
        }
      },
      "indicator.width": {
        "spring": {
          "duration": 0.3,
          "bounce": 0.1
        }
      }
    },
    "initial": "first",
    "when": {
      "seg1.tap": "first",
      "seg2.tap": "second",
      "seg3.tap": "third"
    },
    "states": {
      "first": {
        "set": {
          "indicator.x": {
            "measure": "seg1.x"
          }
        }
      },
      "second": {
        "set": {
          "indicator.x": {
            "measure": "seg2.x"
          },
          "indicator.width": {
            "measure": "seg2.width"
          }
        }
      },
      "third": {
        "set": {
          "indicator.x": {
            "measure": "seg3.x"
          },
          "indicator.width": {
            "measure": "seg3.width"
          }
        }
      }
    }
  },
  "steps": [
    {
      "t": 0,
      "expect": {
        "state": [
          "first"
        ],
        "values": {
          "indicator.x": 0,
          "indicator.width": 0
        }
      }
    },
    {
      "t": 0,
      "input": "indicator.layout.x",
      "value": 10
    },
    {
      "t": 0,
      "input": "seg1.layout.x",
      "value": 10
    },
    {
      "t": 0,
      "input": "seg1.layout.width",
      "value": 60
    },
    {
      "t": 0,
      "input": "seg2.layout.x",
      "value": 70
    },
    {
      "t": 0,
      "input": "seg2.layout.width",
      "value": 90
    },
    {
      "t": 0,
      "input": "seg3.layout.x",
      "value": 160
    },
    {
      "t": 0,
      "input": "seg3.layout.width",
      "value": 50
    },
    {
      "t": 0,
      "expect": {
        "values": {
          "indicator.x": 0.0,
          "indicator.width": 60.0
        }
      }
    },
    {
      "t": 0.1,
      "send": "seg2.tap"
    },
    {
      "t": 0.15,
      "expect": {
        "state": [
          "second"
        ],
        "values": {
          "indicator.x": 17.736446605,
          "indicator.width": 68.868223302
        }
      }
    },
    {
      "t": 0.2,
      "expect": {
        "state": [
          "second"
        ],
        "values": {
          "indicator.x": 39.545394232,
          "indicator.width": 79.772697116
        }
      }
    },
    {
      "t": 0.3,
      "expect": {
        "state": [
          "second"
        ],
        "values": {
          "indicator.x": 57.585339091,
          "indicator.width": 88.792669546
        }
      }
    },
    {
      "t": 0.3,
      "input": "seg2.layout.x",
      "value": 74
    },
    {
      "t": 0.3,
      "input": "seg2.layout.width",
      "value": 96
    },
    {
      "t": 0.35,
      "expect": {
        "state": [
          "second"
        ],
        "values": {
          "indicator.x": 60.69151485,
          "indicator.width": 91.528187199
        }
      }
    },
    {
      "t": 0.45,
      "expect": {
        "state": [
          "second"
        ],
        "values": {
          "indicator.x": 63.56467861,
          "indicator.width": 95.256235775
        }
      }
    },
    {
      "t": 0.7,
      "expect": {
        "state": [
          "second"
        ],
        "values": {
          "indicator.x": 64.004584255,
          "indicator.width": 96.006290752
        }
      }
    },
    {
      "t": 0.7,
      "input": "seg3.layout.x",
      "value": 170
    },
    {
      "t": 0.8,
      "expect": {
        "values": {
          "indicator.x": 64.000571088,
          "indicator.width": 96.0009923
        }
      }
    }
  ]
}
