{
  "conformance": "0.4",
  "name": "Layout: before the host reports, a measured value is its base; the first report places it",
  "doc": {
    "nudg": "0.4",
    "targets": [
      "seg1",
      "seg2",
      "seg3",
      "indicator"
    ],
    "values": {
      "indicator.x": 5,
      "indicator.width": {
        "measure": "seg1.width"
      }
    },
    "animate": {
      "indicator.x": {
        "spring": {
          "duration": 0.3,
          "bounce": 0.1
        }
      },
      "indicator.width": {
        "spring": {
          "duration": 0.3,
          "bounce": 0.1
        }
      }
    },
    "initial": "first",
    "when": {
      "seg1.tap": "first",
      "seg2.tap": "second",
      "seg3.tap": "third"
    },
    "states": {
      "first": {
        "set": {
          "indicator.x": {
            "measure": "seg1.x"
          }
        }
      },
      "second": {
        "set": {
          "indicator.x": {
            "measure": "seg2.x"
          },
          "indicator.width": {
            "measure": "seg2.width"
          }
        }
      },
      "third": {
        "set": {
          "indicator.x": {
            "measure": "seg3.x"
          },
          "indicator.width": {
            "measure": "seg3.width"
          }
        }
      }
    }
  },
  "steps": [
    {
      "t": 0.1,
      "send": "seg3.tap"
    },
    {
      "t": 0.2,
      "expect": {
        "state": [
          "third"
        ],
        "values": {
          "indicator.x": 5,
          "indicator.width": 0
        }
      }
    },
    {
      "t": 0.3,
      "input": "indicator.layout.x",
      "value": 10
    },
    {
      "t": 0.3,
      "input": "seg3.layout.x",
      "value": 160
    },
    {
      "t": 0.3,
      "expect": {
        "values": {
          "indicator.x": 150
        }
      }
    }
  ]
}
