{
  "conformance": "0.10",
  "name": "Loop: a starting state loops from time 0; a measured end holds the offset at 0 until layout, then follows relayout",
  "doc": {
    "nudg": "0.10",
    "targets": [
      "track",
      "highlight"
    ],
    "values": {
      "highlight.x": 0
    },
    "initial": "loading",
    "states": {
      "loading": {
        "loop": {
          "highlight.x": {
            "to": {
              "measure": "track.width"
            },
            "duration": 1,
            "ease": "in-out"
          }
        },
        "when": {
          "host.loaded": "loaded"
        }
      },
      "loaded": {}
    }
  },
  "steps": [
    {
      "t": 0,
      "expect": {
        "state": [
          "loading"
        ],
        "values": {
          "highlight.x": 0
        },
        "looping": true,
        "resting": true
      }
    },
    {
      "t": 0.1,
      "expect": {
        "values": {
          "highlight.x": 0
        }
      }
    },
    {
      "t": 0.2,
      "input": "track.layout.width",
      "value": 200
    },
    {
      "t": 0.3,
      "expect": {
        "values": {
          "highlight.x": 37.479181341
        }
      }
    },
    {
      "t": 0.5,
      "input": "track.layout.width",
      "value": 100
    },
    {
      "t": 0.55,
      "expect": {
        "values": {
          "highlight.x": 58.566029102
        }
      }
    },
    {
      "t": 1.3,
      "expect": {
        "values": {
          "highlight.x": 18.739590671
        }
      }
    },
    {
      "t": 1.4,
      "send": "host.loaded"
    },
    {
      "t": 1.4,
      "expect": {
        "state": [
          "loaded"
        ],
        "looping": false
      }
    }
  ]
}
