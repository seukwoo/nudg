        "from": "button",
        "count": 1,
        "angle": -90,
        "speed": 800,
        "gravity": 1500,
        "drag": 2,
        "spin": 0,
        "life": 2,
        "fade": 0,
        "scale": 1,
        "seed": 1
      }
    },
    "initial": "idle",
