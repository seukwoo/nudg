{
  "conformance": "0.18",
  "name": "Pinch: inputs start over at each pinchstart; a multiplying follow scales by the ratio since entry, within its range",
  "doc": {
    "nudg": "0.18",
    "targets": [
      "image"
    ],
    "values": {
      "image.scale": 1,
      "image.x": 0
    },
    "initial": "held",
    "states": {
      "held": {
        "when": {
          "image.pinchstart": "pinching"
        }
      },
      "pinching": {
        "follow": {
          "image.scale": {
            "input": "image.pinch.scale",
            "multiply": true,
            "range": [
              1,
              4
            ],
            "overdrag": 0.3
          },
          "image.x": "image.pinch.x"
        },
        "when": {
          "image.pinchend": {
            "to": "held",
            "commit": [
              "image.scale",
              "image.x"
            ]
          }
        }
      }
    }
  },
  "steps": [
    {
      "t": 0.1,
      "send": "image.pinchstart"
    },
    {
      "t": 0.1,
      "expect": {
        "state": [
          "pinching"
        ],
        "values": {
          "image.scale": 1,
          "image.x": 0
        }
      }
    },
    {
      "t": 0.15,
      "input": "image.pinch.scale",
      "value": 1.5
    },
    {
      "t": 0.15,
      "input": "image.pinch.x",
      "value": 20
    },
    {
      "t": 0.15,
      "expect": {
        "values": {
          "image.scale": 1.5,
          "image.x": 20
        }
      }
    },
    {
      "t": 0.2,
      "send": "image.pinchend"
    },
    {
      "t": 0.2,
      "expect": {
        "state": [
          "held"
        ],
        "values": {
          "image.scale": 1.5,
          "image.x": 20
        }
      }
    },
    {
      "t": 0.5,
      "send": "image.pinchstart"
    },
    {
      "t": 0.5,
      "expect": {
        "values": {
          "image.scale": 1.5,
          "image.x": 20
        }
      }
    },
    {
      "t": 0.55,
      "input": "image.pinch.scale",
      "value": 2
    },
    {
      "t": 0.55,
      "input": "image.pinch.x",
      "value": -5
    },
    {
      "t": 0.55,
      "expect": {
        "values": {
          "image.scale": 3,
          "image.x": 15
        }
      }
    },
    {
      "t": 0.6,
      "input": "image.pinch.scale",
      "value": 4
    },
    {
      "t": 0.6,
      "expect": {
        "values": {
          "image.scale": 4.6
        }
      }
    }
  ]
}
