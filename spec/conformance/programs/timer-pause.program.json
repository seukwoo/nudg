{
 "nudgProgram": 6,
 "version": "0.7",
 "targets": [
  "toast"
 ],
 "properties": [
  {
   "key": "toast.opacity",
   "kind": "number",
   "base": [
    0
   ]
  }
 ],
 "animate": [],
 "machine": {
  "kind": "states",
  "initial": "hidden",
  "states": [
   {
    "name": "hidden",
    "set": [],
    "measure": [],
    "follow": [],
    "glide": [],
    "enter": [],
    "loop": [],
    "when": [],
    "timers": []
   },
   {
    "name": "shown",
    "set": [
     {
      "key": "toast.opacity",
      "value": [
       1
      ]
     }
    ],
    "measure": [],
    "follow": [],
    "glide": [],
    "enter": [],
    "loop": [],
    "when": [],
    "timers": [
     {
      "key": "after:1s",
      "delay": 1,
      "pause": [
       {
        "on": "toast.hoverstart",
        "off": "toast.hoverend"
       },
       {
        "on": "toast.focus",
        "off": "toast.blur"
       },
       {
        "on": "host.suspend",
        "off": "host.resume"
       }
      ],
      "transition": {
       "animate": [],
       "to": "hidden"
      }
     }
    ]
   }
  ],
  "when": [
   {
    "event": "host.show",
    "animate": [],
    "to": "shown"
   }
  ]
 }
}
