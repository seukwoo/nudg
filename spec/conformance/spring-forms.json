{
  "conformance": "0.1",
  "name": "Spring: every parameter form describes the same physical spring",
  "doc": {
    "nudg": "0.1",
    "targets": [
      "a",
      "b",
      "c",
      "d",
      "e"
    ],
    "values": {
      "a.x": 0,
      "b.x": 0,
      "c.x": 0,
      "d.x": 0,
      "e.x": 0
    },
    "animate": {
      "a.x": {
        "spring": {
          "duration": 0.4,
          "bounce": 0.3
        }
      },
      "b.x": {
        "spring": {
          "response": "400ms",
          "dampingFraction": 0.7
        }
      },
      "c.x": {
        "spring": {
          "stiffness": 246.74011002723395,
          "dampingRatio": 0.7
        }
      },
      "d.x": {
        "spring": {
          "stiffness": 246.74011002723395,
          "damping": 21.991148575128552
        }
      },
      "e.x": {
        "spring": {
          "stiffness": 493.4802200544679,
          "damping": 43.982297150257104,
          "mass": 2
        }
      }
    },
    "initial": "rest",
    "states": {
      "rest": {
        "when": {
          "a.tap": "moved"
        }
      },
      "moved": {
        "set": {
          "a.x": 100,
          "b.x": 100,
          "c.x": 100,
          "d.x": 100,
          "e.x": 100
        }
      }
    }
  },
