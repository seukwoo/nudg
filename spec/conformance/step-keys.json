{
  "conformance": "0.3",
  "name": "step: keys add to the base value, clamped to max; unhandled keys are reported",
  "doc": {
    "nudg": "0.3",
    "targets": [
      "thumb"
    ],
    "values": {
      "thumb.x": {
        "base": 0,
        "min": 0,
        "max": 100
      }
    },
    "animate": {
      "thumb.x": {
        "spring": {
          "duration": 0.3,
          "bounce": 0
        }
      }
    },
    "initial": "idle",
    "states": {
      "idle": {
        "when": {
          "thumb.key.arrowright": {
            "step": {
              "thumb.x": 10
            }
          },
          "thumb.key.arrowleft": {
            "step": {
              "thumb.x": -10
            }
          },
          "thumb.key.end": {
            "step": {
              "thumb.x": 1000
            }
          },
          "thumb.dragstart": "dragging"
        }
      },
      "dragging": {
        "follow": {
          "thumb.x": "thumb.drag.x"
        },
        "when": {
          "thumb.dragend": {
            "to": "idle",
            "commit": [
              "thumb.x"
            ]
          }
        }
      }
    }
  },
  "steps": [
    {
      "t": 0.1,
      "send": "thumb.key.arrowright"
    },
    {
      "t": 0.2,
      "expect": {
        "state": [
          "idle"
        ],
        "values": {
          "thumb.x": 6.189416092
        }
      }
    },
    {
      "t": 0.2,
      "send": "thumb.key.arrowright"
    },
    {
      "t": 0.25,
      "send": "thumb.key.arrowright"
    },
    {
      "t": 0.4,
      "expect": {
        "values": {
          "thumb.x": 27.287385911
        }
      }
    },
    {
      "t": 1.0,
      "send": "thumb.key.end"
    },
    {
      "t": 1.3,
      "expect": {
        "values": {
          "thumb.x": 99.047934706
        }
      }
    },
    {
      "t": 2.0,
      "send": "thumb.key.arrowleft"
    },
    {
      "t": 2.2,
      "expect": {
        "values": {
          "thumb.x": 90.786860288
        }
      }
    },
    {
      "t": 2.2,
      "send": "thumb.key.space",
      "handled": false
    }
  ]
}
