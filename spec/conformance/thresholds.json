{
  "conformance": "0.15",
  "name": "Thresholds: scroll direction turns after 8 units back from the furthest point; an input crossing fires on entering its side, once until it leaves",
  "doc": {
    "nudg": "0.15",
    "targets": [
      "scroller",
      "bar",
      "dot"
    ],
    "values": {
      "bar.y": 0,
      "dot.scale": 1
    },
    "regions": {
      "bar": {
        "initial": "shown",
        "when": {
          "scroller.scroll.y<40": "shown"
        },
        "states": {
          "shown": {
            "when": {
              "scroller.scrolldown": "hidden"
            }
          },
          "hidden": {
            "set": {
              "bar.y": -56
            },
            "when": {
              "scroller.scrollup": "shown"
            }
          }
        }
      },
      "voice": {
        "initial": "quiet",
        "states": {
          "quiet": {
            "when": {
              "host.volume>0.6": "speaking"
            }
          },
          "speaking": {
            "set": {
              "dot.scale": 1.3
            },
            "when": {
              "host.volume<0.3": "quiet",
              "host.volume>0.6": "loud"
            }
          },
          "loud": {
            "when": {
              "host.volume<0.3": "quiet"
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "t": 0.1,
      "input": "scroller.scroll.y",
      "value": 5
    },
    {
      "t": 0.1,
      "expect": {
        "state": [
          "bar/shown",
          "voice/quiet"
        ]
      }
    },
    {
      "t": 0.2,
      "input": "scroller.scroll.y",
      "value": 60
    },
    {
      "t": 0.2,
      "expect": {
        "state": [
          "bar/hidden",
          "voice/quiet"
        ]
      }
    },
    {
      "t": 0.3,
      "input": "scroller.scroll.y",
      "value": 55
    },
    {
      "t": 0.3,
      "expect": {
        "state": [
          "bar/hidden",
          "voice/quiet"
        ]
      }
    },
    {
      "t": 0.4,
      "input": "scroller.scroll.y",
      "value": 45
    },
    {
      "t": 0.4,
      "expect": {
        "state": [
          "bar/shown",
          "voice/quiet"
        ]
      }
    },
    {
      "t": 0.5,
      "input": "scroller.scroll.y",
      "value": 120
    },
    {
      "t": 0.5,
      "expect": {
        "state": [
          "bar/hidden",
          "voice/quiet"
        ]
      }
    },
    {
      "t": 0.6,
      "input": "scroller.scroll.y",
      "value": 20
    },
    {
      "t": 0.6,
      "expect": {
        "state": [
          "bar/shown",
          "voice/quiet"
        ]
      }
    },
    {
      "t": 1.0,
      "input": "host.volume",
      "value": 0.7
    },
    {
      "t": 1.0,
      "expect": {
        "state": [
          "bar/shown",
          "voice/speaking"
        ]
      }
    },
    {
      "t": 1.1,
      "input": "host.volume",
      "value": 0.9
    },
    {
      "t": 1.1,
      "expect": {
        "state": [
          "bar/shown",
          "voice/speaking"
        ]
      }
    },
    {
      "t": 1.2,
      "input": "host.volume",
      "value": 0.5
    },
    {
      "t": 1.2,
      "expect": {
        "state": [
          "bar/shown",
          "voice/speaking"
        ]
      }
    },
    {
      "t": 1.3,
      "input": "host.volume",
      "value": 0.65
    },
    {
      "t": 1.3,
      "expect": {
        "state": [
          "bar/shown",
          "voice/loud"
        ]
      }
    },
    {
      "t": 1.4,
      "input": "host.volume",
      "value": 0.2
    },
    {
      "t": 1.4,
      "expect": {
        "state": [
          "bar/shown",
          "voice/quiet"
        ]
      }
    }
  ]
}
