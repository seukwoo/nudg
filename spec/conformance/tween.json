{
  "conformance": "0.1",
  "name": "Tween: linear and cubic B\u00e9zier (with overshoot); a retarget restarts from the current value",
  "doc": {
    "nudg": "0.1",
    "targets": [
      "a",
      "b"
    ],
    "values": {
      "a.opacity": 0,
      "b.x": 0
    },
    "animate": {
      "a.opacity": {
        "tween": {
          "duration": "200ms",
          "ease": "linear"
        }
      },
      "b.x": {
        "tween": {
          "duration": 0.4,
          "ease": [
            0.2,
            0.8,
            0.4,
            1.2
          ]
        }
      }
    },
    "initial": "hidden",
    "states": {
      "hidden": {
        "when": {
          "a.tap": "shown"
        }
      },
      "shown": {
        "set": {
          "a.opacity": 1,
          "b.x": 100
        },
        "when": {
          "a.tap": "hidden"
        }
      }
    }
  },
  "steps": [
    {
      "t": 0,
      "send": "a.tap"
    },
    {
      "t": 0.05,
      "expect": {
        "values": {
          "a.opacity": 0.25,
          "b.x": 43.565106599
        }
      }
    },
    {
      "t": 0.1,
      "expect": {
        "values": {
          "a.opacity": 0.5,
          "b.x": 72.783837621
        }
      }
    },
    {
      "t": 0.2,
      "expect": {
        "values": {
          "a.opacity": 1.0,
          "b.x": 99.815443477
        }
      }
    },
    {
      "t": 0.3,
      "expect": {
        "values": {
          "a.opacity": 1.0,
          "b.x": 105.043334876
        }
      }
    },
    {
      "t": 0.3,
      "send": "a.tap"
    },
    {
      "t": 0.35,
      "expect": {
        "values": {
          "a.opacity": 0.75,
          "b.x": 59.281094062
        }
      }
    },
    {
      "t": 0.5,
      "expect": {
        "values": {
          "a.opacity": 0.0,
          "b.x": 0.193864327
        }
      }
    },
    {
      "t": 0.8,
      "expect": {
        "values": {
          "a.opacity": 0.0,
          "b.x": 0.0
        }
      }
    }
  ]
}
