{
  "conformance": "0.10",
  "name": "Validator (0.10): loops",
  "documents": [
    {
      "name": "needs-version",
      "doc": {
        "nudg": "0.9",
        "targets": [
          "spinner"
        ],
        "values": {
          "spinner.rotation": 0,
          "spinner.opacity": 0
        },
        "animate": {
          "spinner.rotation": {
            "spring": {
              "duration": 0.3,
              "bounce": 0
            }
          },
          "spinner.opacity": {
            "tween": {
              "duration": 0.2,
              "ease": "linear"
            }
          }
        },
        "initial": "idle",
        "states": {
          "idle": {
            "when": {
              "host.start": "busy"
            }
          },
          "busy": {
            "set": {
              "spinner.opacity": 1
            },
            "loop": {
              "spinner.rotation": {
                "to": 360,
                "duration": 1,
                "wrap": 360
              }
            },
            "when": {
              "host.done": "idle"
            }
          }
        }
      },
      "errors": [
        {
          "code": "needs-version",
          "path": "/states/busy/loop"
        }
      ]
    },
