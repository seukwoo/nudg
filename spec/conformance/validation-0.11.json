{
  "conformance": "0.11",
  "name": "Validator (0.11): measured map values",
  "documents": [
    {
      "name": "needs-version",
      "doc": {
        "nudg": "0.10",
        "targets": [
          "screen",
          "previous"
        ],
        "values": {
          "screen.x": {
            "measure": "screen.width"
          },
          "previous.x": {
            "map": "screen.x",
            "from": [
              0,
              {
                "measure": "screen.width"
              }
            ],
            "to": [
              {
                "measure": "screen.width",
                "times": -0.3
              },
              0
            ]
          }
        },
        "animate": {
          "screen.x": {
            "spring": {
              "duration": 0.35,
              "bounce": 0
            }
          }
        },
        "initial": "pushed",
        "states": {
          "pushed": {
            "set": {
              "screen.x": 0
            },
            "when": {
              "screen.dragstart": "dragging"
            }
          },
          "popped": {},
          "dragging": {
            "follow": {
              "screen.x": {
                "input": "screen.drag.x",
                "range": [
                  0,
                  {
                    "measure": "screen.width"
                  }
                ]
              }
            },
            "when": {
              "screen.dragend": {
                "nearest": [
                  "pushed",
                  "popped"
                ],
                "by": "screen.x"
              }
            }
          }
        }
      },
      "errors": [
        {
          "code": "needs-version",
          "path": "/values/previous.x/to/0"
        }
      ]
    },
    {
