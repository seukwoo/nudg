{
  "conformance": "0.13",
  "name": "Validator (0.13): with a host declaration, only declared app events and inputs are accepted",
  "documents": [
    {
      "name": "declared",
      "doc": {
        "nudg": "0.13",
        "host": {
          "events": [
            "show",
            "hide"
          ],
          "inputs": {
            "level": {
              "range": [
                0,
                1
              ]
            }
          }
        },
        "targets": [
          "toast"
        ],
        "values": {
          "toast.opacity": 0,
          "toast.scale": {
            "map": "host.level",
            "from": [
              0,
              1
            ],
            "to": [
              1,
              1.2
            ]
          }
        },
        "initial": "hidden",
        "states": {
          "hidden": {
            "when": {
              "host.show": "shown"
            }
          },
          "shown": {
            "set": {
              "toast.opacity": 1
            },
            "when": {
              "host.hide": "hidden"
            }
          }
        }
      },
      "errors": []
    },
