{
  "conformance": "0.15",
  "name": "Validator (0.15): crossing and scroll direction events",
  "documents": [
    {
      "name": "needs-version",
      "doc": {
        "nudg": "0.14",
        "targets": [
          "scroller",
          "bar",
          "dot"
        ],
        "values": {
          "bar.y": 0,
          "dot.scale": 1
        },
        "regions": {
          "bar": {
            "initial": "shown",
            "when": {
              "scroller.scroll.y<40": "shown"
            },
            "states": {
              "shown": {
                "when": {
                  "scroller.scrolldown": "hidden"
                }
              },
              "hidden": {
                "set": {
                  "bar.y": -56
                },
                "when": {
                  "scroller.scrollup": "shown"
                }
              }
            }
          },
          "voice": {
            "initial": "quiet",
            "states": {
              "quiet": {
                "when": {
                  "host.volume>0.6": "speaking"
                }
              },
              "speaking": {
                "set": {
                  "dot.scale": 1.3
                },
                "when": {
                  "host.volume<0.3": "quiet",
                  "host.volume>0.6": "loud"
                }
              },
              "loud": {
                "when": {
                  "host.volume<0.3": "quiet"
                }
              }
            }
          }
        }
      },
      "errors": [
        {
          "code": "needs-version",
          "path": "/regions/bar/when/scroller.scroll.y<40"
        },
        {
          "code": "needs-version",
          "path": "/regions/bar/states/shown/when/scroller.scrolldown"
        },
        {
          "code": "needs-version",
          "path": "/regions/bar/states/hidden/when/scroller.scrollup"
        },
        {
          "code": "needs-version",
          "path": "/regions/voice/states/quiet/when/host.volume>0.6"
        },
        {
          "code": "needs-version",
          "path": "/regions/voice/states/speaking/when/host.volume<0.3"
        },
        {
          "code": "needs-version",
          "path": "/regions/voice/states/speaking/when/host.volume>0.6"
        },
        {
          "code": "needs-version",
          "path": "/regions/voice/states/loud/when/host.volume<0.3"
        }
      ]
    },
    {
      "name": "operator",
      "doc": {
        "nudg": "0.15",
        "targets": [
          "scroller",
          "bar",
          "dot"
        ],
        "values": {
          "bar.y": 0,
          "dot.scale": 1
        },
        "regions": {
          "bar": {
            "initial": "shown",
            "when": {
              "scroller.scroll.y<40": "shown"
            },
            "states": {
              "shown": {
                "when": {
                  "scroller.scrolldown": "hidden"
                }
              },
              "hidden": {
                "set": {
                  "bar.y": -56
                },
                "when": {
                  "scroller.scrollup": "shown"
                }
              }
            }
          },
          "voice": {
            "initial": "quiet",
            "states": {
              "quiet": {
                "when": {
                  "host.volume>=0.6": "speaking"
                }
              },
              "speaking": {
                "set": {
                  "dot.scale": 1.3
                },
                "when": {
                  "host.volume<0.3": "quiet",
                  "host.volume>0.6": "loud"
                }
              },
              "loud": {
                "when": {
                  "host.volume<0.3": "quiet"
                }
              }
            }
          }
        }
      },
      "errors": [
        {
          "code": "invalid-event",
          "path": "/regions/voice/states/quiet/when/host.volume>=0.6"
        }
      ]
    },
    {
      "name": "not-an-input",
      "doc": {
        "nudg": "0.15",
        "targets": [
          "scroller",
          "bar",
          "dot"
        ],
        "values": {
          "bar.y": 0,
          "dot.scale": 1
        },
        "regions": {
          "bar": {
            "initial": "shown",
            "when": {
              "scroller.scroll.y<40": "shown"
            },
            "states": {
              "shown": {
                "when": {
                  "scroller.scrolldown": "hidden"
                }
              },
              "hidden": {
                "set": {
                  "bar.y": -56
                },
                "when": {
                  "scroller.scrollup": "shown"
                }
              }
            }
          },
          "voice": {
            "initial": "quiet",
            "states": {
              "quiet": {
                "when": {
                  "dot.scale>1": "speaking"
                }
              },
              "speaking": {
                "set": {
                  "dot.scale": 1.3
                },
                "when": {
                  "host.volume<0.3": "quiet",
                  "host.volume>0.6": "loud"
                }
              },
              "loud": {
                "when": {
                  "host.volume<0.3": "quiet"
                }
              }
            }
          }
        }
      },
      "errors": [
        {
          "code": "unknown-input",
          "path": "/regions/voice/states/quiet/when/dot.scale>1"
        }
      ]
    }
  ]
}
