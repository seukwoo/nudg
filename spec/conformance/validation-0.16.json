{
  "conformance": "0.16",
  "name": "Validator (0.16): glide",
  "documents": [
    {
      "name": "needs-version",
      "doc": {
        "nudg": "0.15",
        "targets": [
          "strip"
        ],
        "values": {
          "strip.x": 0
        },
        "animate": {
          "strip.x": {
            "spring": {
              "duration": 0.4,
              "bounce": 0
            }
          }
        },
        "initial": "free",
        "states": {
          "free": {
            "glide": {
              "strip.x": {
                "momentum": 0.4,
                "range": [
                  -300,
                  0
                ]
              }
            },
            "when": {
              "strip.dragstart": "dragging"
            }
          },
          "dragging": {
            "follow": {
              "strip.x": {
                "input": "strip.drag.x",
                "range": [
                  -300,
                  0
                ],
                "overdrag": 0.3
              }
            },
            "when": {
              "strip.dragend": "free"
            }
          }
        }
      },
      "errors": [
        {
          "code": "needs-version",
          "path": "/states/free/glide"
        }
      ]
    },
