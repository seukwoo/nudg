  "documents": [
    {
      "name": "needs-version",
      "doc": {
        "nudg": "0.1",
        "targets": [
          "knob",
          "track"
        ],
        "values": {
          "knob.x": 0,
          "track.color": "#D1D5DB"
        },
        "animate": {
          "knob.x": {
            "spring": {
              "duration": 0.35,
              "bounce": 0.25
            }
          }
        },
        "initial": "off",
        "states": {
          "off": {
            "when": {
              "track.tap": "on",
              "track.dragstart": "dragging"
            }
          },
          "on": {
            "set": {
              "knob.x": 20
            },
            "when": {
              "track.tap": "off",
              "track.dragstart": "dragging"
            }
          },
          "dragging": {
            "follow": {
              "knob.x": {
                "input": "track.drag.x",
                "range": [
                  0,
                  20
                ],
                "overdrag": 0.3
              }
            },
            "when": {
              "track.dragend": {
                "nearest": [
                  "off",
                  "on"
                ],
                "by": "knob.x"
              }
            }
          }
        }
      },
      "errors": [
        {
          "code": "needs-version",
          "path": "/states/off/when/track.dragstart"
        },
        {
          "code": "needs-version",
          "path": "/states/on/when/track.dragstart"
        },
        {
          "code": "needs-version",
          "path": "/states/dragging/follow"
        },
