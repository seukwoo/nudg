    {
      "name": "needs-version",
      "doc": {
        "nudg": "0.2",
        "targets": [
          "thumb"
        ],
        "values": {
          "thumb.x": {
            "base": 0,
            "min": 0,
            "max": 100
          }
        },
        "animate": {
          "thumb.x": {
            "spring": {
              "duration": 0.3,
              "bounce": 0
            }
          }
        },
        "initial": "idle",
        "states": {
          "idle": {
            "when": {
              "thumb.key.arrowright": {
                "step": {
                  "thumb.x": 10
                }
              },
              "thumb.key.arrowleft": {
                "step": {
                  "thumb.x": -10
                }
              },
              "thumb.key.end": {
                "step": {
                  "thumb.x": 1000
                }
              },
              "thumb.dragstart": "dragging"
            }
          },
          "dragging": {
            "follow": {
              "thumb.x": "thumb.drag.x"
            },
            "when": {
              "thumb.dragend": {
                "to": "idle",
                "commit": [
                  "thumb.x"
                ]
              }
            }
          }
        }
      },
      "errors": [
        {
          "code": "needs-version",
          "path": "/values/thumb.x"
        },
        {
          "code": "needs-version",
          "path": "/states/idle/when/thumb.key.arrowright"
        },
        {
