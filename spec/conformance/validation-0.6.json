          },
          "half": {
            "set": {
              "sheet.y": {
                "measure": "sheet.height",
                "times": 0.5,
                "plus": null
              },
              "indicator.x": {
                "measure": "seg2.x",
                "times": 0.5,
                "plus": 4
              }
            }
          }
        }
      },
      "errors": [
        {
          "code": "invalid-measure-arithmetic",
