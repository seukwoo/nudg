          "hidden": {},
          "shown": {
            "set": {
              "toast.opacity": 1
            },
            "when": {
              "after:1s": {
                "to": "hidden",
                "pause": "hover"
              }
            }
          }
        }
      },
      "errors": [
        {
          "code": "invalid-timer-pause",
          "path": "/states/shown/when/after:1s/pause"
        }
      ]
    },
