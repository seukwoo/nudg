{
  "conformance": "0.9",
  "name": "Validator (0.9): measured follow and map endpoints",
  "documents": [
    {
      "name": "needs-version",
      "doc": {
        "nudg": "0.8",
        "targets": [
          "row",
          "content",
          "action"
        ],
        "values": {
          "content.x": 0,
          "action.opacity": {
            "map": "content.x",
            "from": [
              0,
              {
                "measure": "action.width",
                "times": -1
              }
            ],
            "to": [
              0,
              1
            ]
          }
        },
        "initial": "closed",
        "states": {
          "closed": {
            "when": {
              "content.dragstart": "dragging"
            }
          },
          "dragging": {
            "follow": {
              "content.x": {
                "input": "content.drag.x",
                "range": [
                  {
                    "measure": "action.width",
                    "times": -1
                  },
                  0
                ],
                "overdrag": 0.25
              }
            },
            "when": {
              "content.dragend": "closed"
            }
          }
        }
      },
      "errors": [
        {
          "code": "needs-version",
          "path": "/values/action.opacity/from/1"
        },
        {
          "code": "needs-version",
          "path": "/states/dragging/follow/content.x/range/0"
        }
      ]
    },
    {
