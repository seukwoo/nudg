{
  "conformance": "1.3",
  "name": "Validator (1.3): shadow, blur and declared custom properties",
  "documents": [
    {
      "name": "valid",
      "doc": {
        "nudg": "1.3",
        "host": {
          "events": [
            "lift",
            "drop"
          ],
          "custom": [
            "glow"
          ]
        },
        "targets": [
          "card"
        ],
        "values": {
          "card.y": 0,
          "card.shadowY": 2,
          "card.shadowBlur": 4,
          "card.shadowColor": "#00000033",
          "card.blur": 0,
          "card.custom.glow": 0
        },
        "animate": {
          "card.y": {
            "spring": {
              "duration": 0.3,
              "bounce": 0.2
            }
          },
          "card.shadowY": {
            "spring": {
              "duration": 0.3,
              "bounce": 0.2
            }
          },
          "card.shadowBlur": {
            "spring": {
              "duration": 0.3,
              "bounce": 0.2
            }
          },
          "card.shadowColor": {
            "tween": {
              "duration": 0.2,
              "ease": "out"
            }
          },
          "card.blur": {
            "tween": {
              "duration": 0.2,
              "ease": "linear"
            }
          },
          "card.custom.glow": {
            "spring": {
              "duration": 0.4,
              "bounce": 0
            }
          }
        },
        "initial": "resting",
        "when": {
          "host.lift": "lifted",
          "host.drop": "resting"
        },
        "states": {
          "resting": {},
          "lifted": {
            "set": {
              "card.y": -8,
              "card.shadowY": 12,
              "card.shadowBlur": 24,
              "card.shadowColor": "#00000059",
              "card.blur": 2,
              "card.custom.glow": 1
            }
          }
        }
      },
      "errors": []
    },
