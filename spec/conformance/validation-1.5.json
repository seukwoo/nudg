{
  "conformance": "1.5",
  "name": "Validator (1.5): measured entry keyframes and an ease per frame",
  "documents": [
    {
      "name": "valid",
      "doc": {
        "nudg": "1.5",
        "targets": [
          "menu"
        ],
        "values": {
          "menu.x": 0,
          "menu.color": "#ffffff"
        },
        "initial": "idle",
        "states": {
          "idle": {
            "when": {
              "host.show": "shown"
            }
          },
          "shown": {
            "enter": {
              "menu.x": {
                "keyframes": [
                  {
                    "at": 0.5,
                    "value": {
                      "measure": "menu.width",
                      "times": 0.1
                    },
                    "ease": "in"
                  }
                ],
                "duration": 0.3
              },
              "menu.color": {
                "keyframes": [
                  {
                    "at": 0.5,
                    "value": "#ff0000",
                    "ease": "out"
                  }
                ],
                "duration": 0.3
              }
            }
          }
        }
      },
      "errors": []
    },
