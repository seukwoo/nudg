{
  "conformance": "1.8",
  "name": "Validator (1.8): colors the app names",
  "documents": [
    {
      "name": "valid",
      "doc": {
        "nudg": "1.8",
        "note": "A row tinted on hover with colors from the app's theme, which can change while it shows.",
        "host": {
          "colors": {
            "surface": {
              "default": "#FFFFFF"
            },
            "hover": {
              "default": "#E5E7EB"
            }
          }
        },
        "targets": [
          "row"
        ],
        "values": {
          "row.color": {
            "color": "surface"
          }
        },
        "animate": {
          "row.color": {
            "tween": {
              "duration": 0.2,
              "ease": "out"
            }
          }
        },
        "initial": "idle",
        "states": {
          "idle": {
            "when": {
              "row.hoverstart": "over"
            }
          },
          "over": {
            "set": {
              "row.color": {
                "color": "hover"
              }
            },
            "when": {
              "row.hoverend": "idle"
            }
          }
        }
      },
      "errors": []
    },
