{
  "conformance": "1.9",
  "name": "Validator (1.9): emitter paths and delays",
  "documents": [
    {
      "name": "valid",
      "doc": {
        "nudg": "1.9",
        "host": {
          "events": [
            "go"
          ]
        },
        "targets": [
          "button",
          "confetti"
        ],
        "values": {
          "button.scale": 1
        },
        "emitters": {
          "confetti": {
            "from": "button",
            "path": {
              "frames": [
                {
                  "at": 0.4,
                  "y": [
                    -160,
                    -120
                  ]
                },
                {
                  "at": 1,
                  "y": 60
                }
              ]
            }
          }
        },
        "initial": "idle",
        "states": {
          "idle": {
            "when": {
              "host.go": {
                "emit": "confetti"
              }
            }
          }
        }
      },
      "errors": []
    },
