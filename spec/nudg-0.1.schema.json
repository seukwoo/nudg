{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/@nudg/core@0.1/spec/nudg-0.1.schema.json",
  "title": "nudg 0.1",
  "description": "A nudg file: states, the events that move between them, and the motion in between. The schema covers structure; the validator (nudg validate) also checks references such as target names, state names, base values and motion names.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema URL for editors. Runtimes ignore it."
    },
    "nudg": {
      "const": "0.1",
      "description": "Format version, as a string."
    },
    "note": {
      "$ref": "#/$defs/note"
    },
    "import": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Files whose named motions this file uses. Paths are relative to this file."
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      },
      "uniqueItems": true,
      "description": "Names of the views this file animates. The host binds each name to one of its views."
    },
    "values": {
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {
            "$ref": "#/$defs/propertyPath"
          },
          {
            "const": "note"
          },
          {
            "pattern": "^x-"
          }
        ]
      },
      "properties": {
        "note": {
          "$ref": "#/$defs/note"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      },
      "description": "Base value of every property, used when no active state sets it."
    },
    "motions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/motionObject"
      },
      "description": "Named motions. Use a name anywhere a motion is expected."
    },
    "animate": {
      "$ref": "#/$defs/animate"
    },
    "initial": {
      "$ref": "#/$defs/name"
    },
    "states": {
      "$ref": "#/$defs/states"
    },
    "regions": {
      "$ref": "#/$defs/regions"
    }
  },
  "required": [
    "nudg"
  ],
  "patternProperties": {
    "^x-": true
  },
  "additionalProperties": false,
  "dependentRequired": {
    "states": [
      "initial",
      "targets"
    ],
    "regions": [
      "targets"
    ]
  },
  "not": {
    "required": [
      "states",
      "regions"
    ]
  },
  "$defs": {
    "note": {
      "type": "string",
      "description": "A comment. Runtimes ignore it; tools keep it."
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "propertyPath": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*\\.(x|y|width|height|scale|scaleX|scaleY|rotation|opacity|color)$",
      "description": "target.property, e.g. knob.x"
    },
    "eventPath": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*\\.(down|up|cancel|tap)$",
      "description": "target.event, e.g. track.tap"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^-?(\\d+\\.?\\d*|\\.\\d+)(px|pt|dp)$",
          "description": "A length in logical units."
        },
        {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "A hex color."
        }
      ]
    },
    "time": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "description": "Seconds."
        },
        {
          "type": "string",
          "pattern": "^(\\d+\\.?\\d*|\\.\\d+)(ms|s)$"
        }
      ]
    },
    "positiveTime": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Seconds."
        },
        {
          "type": "string",
          "pattern": "^(\\d+\\.?\\d*|\\.\\d+)(ms|s)$"
        }
      ]
    },
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "animate": {
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {
            "$ref": "#/$defs/propertyPath"
          },
          {
            "const": "note"
          },
          {
            "pattern": "^x-"
          }
        ]
      },
      "properties": {
        "note": {
          "$ref": "#/$defs/note"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": {
        "$ref": "#/$defs/motion"
      },
      "description": "How each property travels to its target."
    },
    "motion": {
      "anyOf": [
        {
          "$ref": "#/$defs/name",
          "description": "A named motion."
        },
        {
          "$ref": "#/$defs/motionObject"
        }
      ]
    },
    "motionObject": {
      "type": "object",
      "properties": {
        "note": {
          "$ref": "#/$defs/note"
        },
        "spring": {
          "$ref": "#/$defs/spring"
        },
        "tween": {
          "$ref": "#/$defs/tween"
        },
        "kick": {
          "type": "number",
          "description": "Velocity added on state entry, in units per second. Requires spring."
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "spring"
          ]
        },
        {
          "required": [
            "tween"
          ]
        }
      ],
      "dependentRequired": {
        "kick": [
          "spring"
        ]
      }
    },
    "spring": {
      "type": "object",
      "description": "One physical spring, in exactly one parameter form.",
      "oneOf": [
        {
          "title": "duration + bounce (default form)",
          "properties": {
            "note": {
              "$ref": "#/$defs/note"
            },
            "duration": {
              "$ref": "#/$defs/positiveTime",
              "description": "Perceptual duration."
            },
            "bounce": {
              "type": "number",
              "exclusiveMaximum": 1,
              "description": "0 = no overshoot, toward 1 = more bounce, negative = overdamped."
            }
          },
          "required": [
            "duration"
          ],
          "patternProperties": {
            "^x-": true
          },
          "additionalProperties": false
        },
        {
          "title": "response + dampingFraction",
          "properties": {
            "note": {
              "$ref": "#/$defs/note"
            },
            "response": {
              "$ref": "#/$defs/positiveTime"
            },
            "dampingFraction": {
              "$ref": "#/$defs/positive"
            }
          },
          "required": [
            "response"
          ],
          "patternProperties": {
            "^x-": true
          },
          "additionalProperties": false
        },
        {
          "title": "stiffness + dampingRatio (mass 1)",
          "properties": {
            "note": {
              "$ref": "#/$defs/note"
            },
            "stiffness": {
              "$ref": "#/$defs/positive"
            },
            "dampingRatio": {
              "$ref": "#/$defs/positive"
            }
          },
          "required": [
            "stiffness",
            "dampingRatio"
          ],
          "patternProperties": {
            "^x-": true
          },
          "additionalProperties": false
        },
        {
          "title": "stiffness + damping + mass",
          "properties": {
            "note": {
              "$ref": "#/$defs/note"
            },
            "stiffness": {
              "$ref": "#/$defs/positive"
            },
            "damping": {
              "$ref": "#/$defs/positive"
            },
            "mass": {
              "$ref": "#/$defs/positive"
            }
          },
          "required": [
            "stiffness",
            "damping"
          ],
          "patternProperties": {
            "^x-": true
          },
          "additionalProperties": false
        }
      ]
    },
    "tween": {
      "type": "object",
      "properties": {
        "note": {
          "$ref": "#/$defs/note"
        },
        "duration": {
          "$ref": "#/$defs/time"
        },
        "ease": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "in",
                "out",
                "in-out",
                "in-sine",
                "out-sine",
                "in-out-sine",
                "in-quad",
                "out-quad",
                "in-out-quad",
                "in-cubic",
                "out-cubic",
                "in-out-cubic",
                "in-quart",
                "out-quart",
                "in-out-quart",
                "in-quint",
                "out-quint",
                "in-out-quint",
                "in-expo",
                "out-expo",
                "in-out-expo",
                "in-circ",
                "out-circ",
                "in-out-circ",
                "in-back",
                "out-back",
                "in-out-back"
              ]
            },
            {
              "type": "array",
              "description": "Cubic Bézier [x1, y1, x2, y2]; x values in [0, 1].",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 4,
              "maxItems": 4
            }
          ]
        }
      },
      "required": [
        "duration"
      ],
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "anyOf": [
          {
            "$ref": "#/$defs/name"
          },
          {
            "pattern": "^x-"
          }
        ]
      },
      "properties": {
        "note": {
          "$ref": "#/$defs/note"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": {
        "$ref": "#/$defs/state"
      }
    },
    "regions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "anyOf": [
          {
            "$ref": "#/$defs/name"
          },
          {
            "pattern": "^x-"
          }
        ]
      },
      "properties": {
        "note": {
          "$ref": "#/$defs/note"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": {
        "$ref": "#/$defs/machine"
      }
    },
    "machine": {
      "type": "object",
      "properties": {
        "note": {
          "$ref": "#/$defs/note"
        },
        "initial": {
          "$ref": "#/$defs/name"
        },
        "states": {
          "$ref": "#/$defs/states"
        },
        "regions": {
          "$ref": "#/$defs/regions"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "initial",
            "states"
          ]
        },
        {
          "required": [
            "regions"
          ],
          "not": {
            "required": [
              "initial"
            ]
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "properties": {
        "note": {
          "$ref": "#/$defs/note"
        },
        "set": {
          "type": "object",
          "propertyNames": {
            "anyOf": [
              {
                "$ref": "#/$defs/propertyPath"
              },
              {
                "const": "note"
              },
              {
                "pattern": "^x-"
              }
            ]
          },
          "properties": {
            "note": {
              "$ref": "#/$defs/note"
            }
          },
          "patternProperties": {
            "^x-": true
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          },
          "description": "Values while this state is active."
        },
        "enter": {
          "type": "object",
          "propertyNames": {
            "anyOf": [
              {
                "$ref": "#/$defs/propertyPath"
              },
              {
                "const": "note"
              },
              {
                "pattern": "^x-"
              }
            ]
          },
          "properties": {
            "note": {
              "$ref": "#/$defs/note"
            }
          },
          "patternProperties": {
            "^x-": true
          },
          "additionalProperties": {
            "$ref": "#/$defs/motion"
          },
          "description": "Kicks played when this state is entered through a transition."
        },
        "when": {
          "type": "object",
          "propertyNames": {
            "anyOf": [
              {
                "$ref": "#/$defs/eventPath"
              },
              {
                "const": "note"
              },
              {
                "pattern": "^x-"
              }
            ]
          },
          "properties": {
            "note": {
              "$ref": "#/$defs/note"
            }
          },
          "patternProperties": {
            "^x-": true
          },
          "additionalProperties": {
            "$ref": "#/$defs/transition"
          },
          "description": "Transitions: event → sibling state."
        },
        "initial": {
          "$ref": "#/$defs/name"
        },
        "states": {
          "$ref": "#/$defs/states"
        },
        "regions": {
          "$ref": "#/$defs/regions"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false,
      "dependentRequired": {
        "states": [
          "initial"
        ]
      },
      "not": {
        "required": [
          "states",
          "regions"
        ]
      }
    },
    "transition": {
      "anyOf": [
        {
          "$ref": "#/$defs/name",
          "description": "The target state."
        },
        {
          "type": "object",
          "properties": {
            "note": {
              "$ref": "#/$defs/note"
            },
            "to": {
              "$ref": "#/$defs/name"
            },
            "animate": {
              "$ref": "#/$defs/animate"
            }
          },
          "required": [
            "to"
          ],
          "patternProperties": {
            "^x-": true
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
